{
  "name": "repairproof-workspace",
  "private": true,
  "scripts": {
    "build": "npm --prefix functions run build && npm --prefix customer_web run build",
    "test": "npm --prefix functions test",
    "emulators": "firebase emulators:start --project demo-repairproof",
    "seed": "node scripts/seed.mjs --local",
    "test:emulator": "firebase emulators:exec --project demo-repairproof --only auth,firestore,storage,functions \"node scripts/integration.mjs\"",
    "test:handler": "firebase emulators:exec --project demo-repairproof --only auth,firestore,storage \"node scripts/local-check.mjs\"",
    "test:ui": "firebase emulators:exec --project demo-repairproof --only auth,firestore,storage \"node scripts/local-check.mjs scripts/ui-check.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.32.1",
    "playwright": "^1.63.0"
  }
}
